{
  "name": "realtime-chat-server",
  "version": "0.1.0",
  "description": "Backend server for the Realtime Chat App — Node.js, Express, TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "websockets",
    "socket.io"
  ],
  "author": "Oumaima Hannachi",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}