# Copy this file to .env and fill in your local values.
# Do NOT commit .env — only this example file.

# Server configuration
PORT=3000
NODE_ENV=development

# CORS — frontend URL (default: Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=chat_app
DATABASE_USER=chat_user
DATABASE_PASSWORD=your-local-db-password-here